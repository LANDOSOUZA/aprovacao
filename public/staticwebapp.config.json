{
  "routes": [
    {
      "route": "/admin/form*",
      "allowedRoles": ["authenticated"],
      "rewrite": "/index.html"
    },
    {
      "route": "/admin",
      "allowedRoles": ["anonymous"],
      "rewrite": "/index.html"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/admin/form*",
      "/.auth/*",
      "/api/*",
      "/assets/*",
      "/*.{css,js,png,jpg,jpeg,svg,ico}"
    ]
  },
  "responseOverrides": {
    "401": {
      "statusCode": 302,
      "redirect": "/.auth/login/aad"
    }
  }
}